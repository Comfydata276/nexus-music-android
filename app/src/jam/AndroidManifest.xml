<?xml version="1.0" encoding="utf-8"?>
<!-- Jams and linked devices (M6). Merged into the app's manifest only in a build where they
     exist: `jamsExist` in app/build.gradle.kts. With them off, no other app can find anything
     of them on the phone: no activity taking a jam's link, no service. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Jams and steering another device (jam/JamService): the relay's connection held with
         the screens closed, under a notification that says so. Its kind needs a network
         permission held, which CHANGE_NETWORK_STATE (in the main manifest) is. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application>
        <!-- A jam's link from another app: shared to this one as text, or opened where the
             person can choose an app for it (see jam/JamLinkActivity). -->
        <activity
            android:name=".jam.JamLinkActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="@string/jam_join_a_jam">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Not an App Link: a relay's address is the person's own and unknown here, so
                 nothing can be verified (see JamLinkActivity). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="*" android:pathPattern="/j/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/.*/j/.*" />
            </intent-filter>
        </activity>

        <!-- Keeps the relay's connection while in a jam or steering another device. -->
        <service
            android:name=".jam.JamService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
