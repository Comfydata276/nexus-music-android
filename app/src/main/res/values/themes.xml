<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window before Compose draws: the default theme's base colour, so the first frame
         doesn't flash. Everything after is drawn by Compose (see ui/theme). -->
    <style name="Theme.NexusMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/base</item>
        <item name="android:colorBackground">@color/base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
