<?xml version="1.0" encoding="utf-8"?>
<!-- Home servers are often reached over plain HTTP, by IP address. Certificates are the
     system's own: no user-added ones, so nothing installed later can listen in. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
