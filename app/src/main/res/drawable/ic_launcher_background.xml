<?xml version="1.0" encoding="utf-8"?>
<!-- The app mark's tile (assets/app-icon.svg in the Windows app): violet, lighter at the top
     left. The gradient runs across the part a launcher shows (18 to 90 of 108); the system
     cuts the shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0 0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="#FF9B72FB"
                android:endColor="#FF6D28D9" />
        </aapt:attr>
    </path>
</vector>
