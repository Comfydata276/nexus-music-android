<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To notice the phone has a network again, and try again what failed meanwhile. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Download on Wi-Fi only": to ask the system for an unmetered network and bind the
         downloads to it, rather than trust whatever the default route is at that moment. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Playing in the background, with its notification, the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 17: reaching a server on the home network (192.168.x.x and the like). Asked
         for when signing in to one; see LocalAccess. Earlier versions don't have it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Downloads (see downloads/Keeper.kt): carried on by Android's job scheduler after the
         phone restarts; on Android 14 and later as a user-initiated data transfer; before
         14, in a foreground service of the data-sync kind while the app holds it up. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Jams and steering another device (jam/JamService): the relay's connection held with
         the screens closed, under a notification that says so. Its kind needs a network
         permission held, which CHANGE_NETWORK_STATE (above) is. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- The known hosts of media apps (res/xml/allowed_media_browser_callers.xml), so that
         one that connects can be looked up by name and its signing certificate checked,
         whatever Android's rules on which apps may see which. -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.wearable.app" />
        <package android:name="com.google.android.autosimulator" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.carassistant" />
    </queries>

    <!-- No backups: the password is sealed with a key that can't leave this phone, and a
         restored copy of the rest without it would only confuse. Plain HTTP is allowed
         because home servers are often reached by an address like http://192.168.1.10:4533;
         the sign-in screen warns when plain HTTP goes beyond the home network. -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexusMusic"
        tools:targetApi="33">

        <!-- What makes Android Auto list the app as a media app: this, and the file it names. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_bars" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Play X on Nexus Music", said to the phone. -->
        <activity
            android:name=".playback.VoiceActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The player: the app's screens, the notification, headsets and the car all use it.
             Open to every app, as the car must be able to find it; the session itself gives
             a connection only to this app, callers Android trusts with media, and the
             known hosts of media apps (see playback/Access.kt). -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <!-- The older name, which Android Auto and cars ask for. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- A headset's or the car's play button with the app not running: the player starts
             and picks up where it left off, if there is anything to pick up (see
             PlayButtonReceiver). -->
        <receiver
            android:name=".playback.PlayButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- The name the button receiver went by in the first builds (Media3's own class).
             The system remembers, by name, which receiver to send a Play button to while
             the app isn't running, and goes on using the name it was last given until the
             app has next been opened: so the old name still has to lead somewhere after an
             update. It has no filter of its own (the session must find exactly one receiver
             for media buttons, the one above) and is not open to other apps; the system can
             still send to it by name. It starts the player, which resumes, or stops cleanly
             if there is nothing to resume. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="false" />

        <!-- Downloads carried on with nothing on screen, and after a restart (DownloadKeeper). -->
        <service
            android:name=".downloads.DownloadsJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".downloads.DownloadsService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- A jam's link from another app: shared to this one as text, or opened where the
             person can choose an app for it (see jam/JamLinkActivity). -->
        <activity
            android:name=".jam.JamLinkActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="@string/jam_join_a_jam">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Not an App Link: a relay's address is the person's own and unknown here, so
                 nothing can be verified (see JamLinkActivity). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="*" android:pathPattern="/j/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/.*/j/.*" />
            </intent-filter>
        </activity>

        <!-- Keeps the relay's connection while in a jam or steering another device. -->
        <service
            android:name=".jam.JamService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Cover art for the car and the system's media controls, which can't fetch it from
             the server. Read-only, it serves nothing but covers, and only to this app and
             the callers the player itself lets connect (see store/CoverProvider.kt). -->
        <provider
            android:name=".store.CoverProvider"
            android:authorities="${applicationId}.covers"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
