#!/usr/bin/env bash
# A slow link between an emulator and the test server, for seeing downloads part-way (see
# docs/TESTING.md, "Downloads"). The emulator reaches the server at 127.0.0.1:4533 through
# adb's tunnel, which nothing on the emulator's side can slow; this puts a relay in it that
# passes the server's answers on at most N kilobytes a second.
#
#   scripts/slowlink start [KB/s]   (default 200)   scripts/slowlink stop
#   scripts/slowlink cut     the server gone: every connection dropped, new ones refused
#                            (start again to bring it back). Removing adb's reverse rule
#                            is not enough: connections already open carry on through it.
#   scripts/slowlink hole    a black hole: connections are taken and nothing is ever
#                            answered, as on a signal that is there and carries nothing. A
#                            request made into it hangs until the app gives it up.
#
# Uses the phone emulator; NEXUS_DEVICE=phone36 (and so on) for another. **Each emulator has
# a relay of its own** (its own container, and its own port on this machine: the server's
# port plus 1 for the phone, 3 for phone36, 5 for phone31, 7 for the car), so two people
# working on two emulators don't take each other's link away.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
port="${NEXUS_TEST_PORT:-4533}"
case "${NEXUS_DEVICE:-phone}" in
  phone) relay=$((port + 1)); name=nexus-slowlink ;;
  phone36) relay=$((port + 3)); name=nexus-slowlink-phone36 ;;
  phone31) relay=$((port + 5)); name=nexus-slowlink-phone31 ;;
  car) relay=$((port + 7)); name=nexus-slowlink-car ;;
  *) die "unknown device '${NEXUS_DEVICE}'" ;;
esac
# The emulator is pointed at the relay's port, which must be this relay's or nobody's. Another
# server left listening there (a second test server: scripts/instep-check's is on 4536, which
# is phone36's) made a "cut" link reach that server, and the app was right to think it was
# online. Asked after this relay has gone, so only something else can be there.
nobody_on_relay() {
  if (exec 3<>"/dev/tcp/127.0.0.1/$relay") 2>/dev/null; then
    die "something else is listening on port $relay, where this emulator's link is pointed: the emulator would reach it, not nothing. Stop it, or move it to another port"
  fi
}
# A cut or a hole drops what goes through the relay. Connections the app opened through adb's
# own tunnel, before the relay was there (scripts/slowlink stop, or never started), carry on
# to the server: with the app running, start the relay first.
relay_was_up() { docker ps --format '{{.Names}}' | grep -qx "$name"; }

case "${1:-}" in
  start)
    rate="${2:-200}"
    docker rm -f "$name" >/dev/null 2>&1 || true
    nobody_on_relay
    need_rig_image
    docker run -d --rm --name "$name" --network host -v "$root/tools/library":/tools:ro "$rig_image" \
      python3 /tools/slowlink.py "$relay" "$port" "$rate" >/dev/null
    "$root/scripts/emu" adb reverse "tcp:$port" "tcp:$relay" >/dev/null
    say "the emulator now reaches the server at ${rate} KB/s (scripts/slowlink stop to undo)"
    ;;
  cut)
    relay_was_up || say "warning: the relay wasn't running: connections the app already has open go on reaching the server (scripts/slowlink start first, with the app running)"
    docker rm -f "$name" >/dev/null 2>&1 || true
    nobody_on_relay
    "$root/scripts/emu" adb reverse "tcp:$port" "tcp:$relay" >/dev/null
    say "the server is out of reach of the emulator (scripts/slowlink start to bring it back)"
    ;;
  hole)
    # A black hole: the emulator's connections are taken and never answered.
    relay_was_up || say "warning: the relay wasn't running: connections the app already has open go on reaching the server (scripts/slowlink start first, with the app running)"
    docker rm -f "$name" >/dev/null 2>&1 || true
    nobody_on_relay
    need_rig_image
    docker run -d --rm --name "$name" --network host -v "$root/tools/library":/tools:ro "$rig_image" \
      python3 /tools/slowlink.py "$relay" "$port" -1 >/dev/null
    "$root/scripts/emu" adb reverse "tcp:$port" "tcp:$relay" >/dev/null
    say "the emulator's link to the server swallows everything and answers nothing (scripts/slowlink stop to undo)"
    ;;
  stop)
    "$root/scripts/emu" adb reverse "tcp:$port" "tcp:$port" >/dev/null || true
    docker rm -f "$name" >/dev/null 2>&1 || true
    say "the emulator reaches the server directly again"
    ;;
  *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
