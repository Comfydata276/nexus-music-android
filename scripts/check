#!/usr/bin/env bash
# The checks every piece of work must pass: the debug build, the unit tests and lint, inside
# Docker (see scripts/dx). One Gradle run, so one JVM's worth of memory; --continue runs every
# check even after one fails, so a single run reports all of them, and the exit status is
# non-zero if any failed.
#
#   scripts/check            the three checks
#   scripts/check --release  also the shrunk release build, and its size
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

tasks=(:app:assembleDebug :app:testDebugUnitTest :app:lintDebug)
release=false
for arg in "$@"; do
  case "$arg" in
    --release) release=true; tasks+=(:app:assembleRelease) ;;
    *) echo "scripts/check: unknown option $arg" >&2; exit 2 ;;
  esac
done

# Only what this run made is reported: files left by an earlier run (a test report, an APK)
# are older than this mark. If Gradle found nothing to redo, it says so instead.
mark="$(mktemp)"
trap 'rm -f "$mark"' EXIT

status=0
scripts/dx ./gradlew --no-daemon --continue "${tasks[@]}" || status=$?

# What the tests found, in brief.
python3 - "$root/app/build/test-results/testDebugUnitTest" "$mark" "$status" <<'PY' || true
import glob, os, re, sys
since = os.path.getmtime(sys.argv[2])
paths = glob.glob(sys.argv[1] + "/*.xml")
fresh = [p for p in paths if os.path.getmtime(p) >= since]
if not fresh:
    # Nothing new: up to date if everything passed, otherwise there's nothing to report.
    if paths and sys.argv[3] == "0":
        print("Unit tests: up to date, not run again")
    sys.exit(0)
tests = failed = skipped = 0
for path in fresh:
    head = open(path, encoding="utf-8").read(4096)
    m = re.search(r'tests="(\d+)" skipped="(\d+)" failures="(\d+)" errors="(\d+)"', head)
    if m:
        t, s, f, e = map(int, m.groups())
        tests, skipped, failed = tests + t, skipped + s, failed + f + e
if tests:
    print(f"Unit tests: {tests} run, {failed} failed, {skipped} skipped")
PY

apk=app/build/outputs/apk/release/app-release.apk
if $release && [ -f "$apk" ] && { [ "$apk" -nt "$mark" ] || [ "$status" -eq 0 ]; }; then
  size=$(stat -c %s "$apk")
  note=""
  [ "$apk" -nt "$mark" ] || note=" (up to date, not built again)"
  echo "Release APK: $size bytes ($(( (size + 524288) / 1048576 )) MB)$note"
fi

if [ "$status" -ne 0 ]; then
  echo "scripts/check: FAILED (see above)" >&2
else
  echo "scripts/check: all passed"
fi
exit "$status"
