#!/usr/bin/env bash
# The end-to-end check of keeping in step: a phone and two PCs exchanging in turn through a
# real Navidrome (docs/TESTING.md, "In step with other devices"). The phone is the app's own
# code, client and stores with the shared library it carries; each PC is the Windows app's
# asking of the server and its library's exchange, compiled from the commit the phone's
# library is pinned to (native/Cargo.toml: the Windows release that commit is).
# Besides the exchange in turn: the phone's first exchange against a record full of a PC's
# data, which must leave it byte for byte as it was; a pin made on a phone before it had read
# the PC's pins, and its process killed; a phone upgraded from 0.4.0's files; the answer to
# the phone's write lost, and the PC then setting the opposite; a server whose answers leave
# out a playlist's owner and comment, and one whose sync playlist has an empty comment; a
# phone whose clock is an hour out.
#
#   scripts/instep-check          starts a test server of its own (instance "step"), builds
#                                 the PC (tools/instep, from the pinned commit), runs
#                                 InStepLiveTest against both, and stops the server
#   scripts/instep-check --keep   leaves the server running afterwards (for the emulator)
#   scripts/instep-check --mixed  a household on mixed versions instead: two devices on the
#                                 Windows code at NEXUS_WINDOWS_SRC (the version under test,
#                                 whose exchange is decided in its library) and a PC on
#                                 0.40.4, built from that release's source (NEXUS_WINDOWS_GIT
#                                 says which checkout to take it from, NEXUS_WINDOWS_OLD which
#                                 commit: by default ../nexus-music and the commit "0.40.4").
#                                 No Gradle, and nothing of the phone's: see
#                                 tools/instep/src/household.rs.
#
# Needs Docker, the app's build image and the Windows app's (see tools/instep/README.md).
# The server is wiped first: it is this check's own, and nothing else uses it.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
keep=false
mixed=false
[ "${1:-}" = "--keep" ] && keep=true
[ "${1:-}" = "--mixed" ] && mixed=true
export NEXUS_TEST_PORT="${NEXUS_STEP_PORT:-4536}"

scripts/server --instance step start >/dev/null
scripts/server --instance step reset >/dev/null
$keep || trap 'scripts/server --instance step stop >/dev/null || true' EXIT

# The Windows app's source at a commit, laid out in the cache from the Windows repository's
# history (never in that repository): where its `src` is.
source_at() {
  local commit="$1"
  local cache="${NEXUS_ANDROID_CACHE:-$HOME/.cache/nexus-music-android}"
  local git_dir="${NEXUS_WINDOWS_GIT:-$root/../nexus-music}"
  local src="$cache/windows-$commit"
  if [ ! -f "$src/src/sync.rs" ]; then
    mkdir -p "$src"
    git -C "$git_dir" archive "$commit" src core Cargo.lock Cargo.toml | tar -x -C "$src"
  fi
  echo "$src/src"
}

# The source of 0.40.4, the last version whose exchange is its own.
old_source() {
  local git_dir="${NEXUS_WINDOWS_GIT:-$root/../nexus-music}"
  local old_commit="${NEXUS_WINDOWS_OLD:-$(git -C "$git_dir" log --format=%H --grep='^0\.40\.4$' -1)}"
  [ -n "$old_commit" ] || { echo "scripts/instep-check: the commit of 0.40.4 wasn't found in $git_dir (set NEXUS_WINDOWS_OLD)" >&2; exit 1; }
  source_at "$old_commit"
}

if $mixed; then
  old_src="$(old_source)"
  old="$(NEXUS_WINDOWS_SRC="$old_src" tools/instep/run build | tail -1)"
  new="$(tools/instep/run build | tail -1)"
  mkdir -p build/instep/household
  status=0
  "$new" household --server "http://127.0.0.1:$NEXUS_TEST_PORT" --user tester --password tester-pass-1 --old "$old" --folder build/instep/household | tee build/instep/household.txt || status=$?
  if [ "$status" -ne 0 ]; then
    echo "scripts/instep-check --mixed: FAILED" >&2
  else
    echo "scripts/instep-check --mixed: the household held"
  fi
  exit "$status"
fi

# The PCs are the Windows app at the commit the phone's library is pinned to: the release
# the phone shares its rules with, whatever the Windows checkout beside this one has become
# since. (NEXUS_WINDOWS_SRC, set, is used instead: a Windows checkout being worked on.)
if [ -z "${NEXUS_WINDOWS_SRC:-}" ]; then
  pinned="$(sed -n 's/^nexus-core = .*rev = "\([0-9a-f]\{40\}\)".*/\1/p' native/Cargo.toml)"
  [ -n "$pinned" ] || { echo "scripts/instep-check: native/Cargo.toml doesn't say which commit the library is pinned to" >&2; exit 1; }
  NEXUS_WINDOWS_SRC="$(source_at "$pinned")"
  export NEXUS_WINDOWS_SRC
fi
grep -q "^pub fn read(client: &Client)" "$NEXUS_WINDOWS_SRC/sync.rs" || { echo "scripts/instep-check: the Windows source at $NEXUS_WINDOWS_SRC is from before its exchange was decided in the library (0.40.5)" >&2; exit 1; }
program="$(tools/instep/run build | tail -1)"
mkdir -p build/instep
cp "$program" build/instep/instep

# (Each test of the run adds its lines to this file.)
rm -f app/build/instep/live.txt
status=0
DX_DOCKER_ARGS="-e NEXUS_STEP_SERVER=http://127.0.0.1:$NEXUS_TEST_PORT -e NEXUS_STEP_TOOL=/work/build/instep/instep" \
  scripts/dx ./gradlew --no-daemon :app:cleanTestDebugUnitTest :app:testDebugUnitTest --tests '*InStepLiveTest*' >build/instep/gradle.txt 2>&1 || status=$?
if [ -f app/build/instep/live.txt ]; then cat app/build/instep/live.txt; fi
if [ "$status" -ne 0 ]; then
  grep -E 'FAILED|AssertionError|expected|at org.medianexus' build/instep/gradle.txt | head -20 >&2 || true
  echo "scripts/instep-check: FAILED (the whole of Gradle's output is in build/instep/gradle.txt)" >&2
else
  echo "scripts/instep-check: the phone and the PCs kept in step"
fi
exit "$status"
