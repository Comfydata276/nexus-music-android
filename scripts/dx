#!/usr/bin/env bash
# Run a command inside the nexus-music-android container as the current user.
# Build the image first:  docker build -f docker/build.Dockerfile -t nexus-music-android docker
# The Android SDK, Gradle's downloads and the emulator's files are kept in a cache folder.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cache="${NEXUS_ANDROID_CACHE:-$HOME/.cache/nexus-music-android}"
mkdir -p "$cache/sdk" "$cache/home"
kvm=()
if [ -e /dev/kvm ]; then
  kvm=(--device /dev/kvm --group-add "$(stat -c %g /dev/kvm)")
fi
# Gradle builds take turns: two at once, beside an emulator, run this machine out of memory.
turn=()
if [ "${1:-}" = "./gradlew" ] && command -v flock >/dev/null; then
  turn=(flock "$cache/gradle.lock")
fi
# The project's signing key is handed to the build only when asked for (NEXUS_SIGN=1): it is
# kept outside the repository, and ordinary builds and checks sign with the debug key.
sign=()
if [ -n "${NEXUS_SIGN:-}" ]; then
  keys="${NEXUS_SIGNING_DIR:-$HOME/.config/nexus-music-android}"
  [ -f "$keys/signing.properties" ] || { echo "error: NEXUS_SIGN is set but $keys/signing.properties is missing" >&2; exit 1; }
  sign=(-v "$keys":/signing:ro)
fi
# To work on the shared core and the phone at once: NEXUS_CORE_LOCAL=1 (or the path of a
# core) builds against that core as it lies, read-only, and not the pinned commit of the
# Windows repository (see native/build). Never for a build that ships.
local_core=()
if [ -n "${NEXUS_CORE_LOCAL:-}" ]; then
  from="$NEXUS_CORE_LOCAL"; [ "$from" = 1 ] && from="$root/../nexus-music/core"
  [ -f "$from/Cargo.toml" ] || { echo "error: NEXUS_CORE_LOCAL is set but there is no core at $from" >&2; exit 1; }
  local_core=(-v "$(cd "$from" && pwd)":/core-local:ro -e NEXUS_CORE_LOCAL=/core-local)
fi
# shellcheck disable=SC2086
exec "${turn[@]}" docker run --rm ${DX_DOCKER_ARGS:-} "${kvm[@]}" \
  -u "$(id -u):$(id -g)" --network host \
  -e HOME=/home/dev -e GRADLE_USER_HOME=/home/dev/.gradle \
  -v "$root":/work -v "$cache/home":/home/dev -v "$cache/sdk":/sdk "${sign[@]}" "${local_core[@]}" \
  -w /work nexus-music-android "$@"
