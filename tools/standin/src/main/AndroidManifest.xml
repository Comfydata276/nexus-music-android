<?xml version="1.0" encoding="utf-8"?>
<!-- FIXTURE: a stand-in media app for proving the test rig. Not part of Nexus Music. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:icon="@drawable/ic_standin"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- What makes Android Auto list an app: this, and the file it points to. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_note" />

        <activity
            android:name=".ListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".StandinService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <!-- The older name, which is the one Android Auto and car systems ask for. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Artwork for other apps (the car) to read. Read-only. -->
        <provider
            android:name=".ArtProvider"
            android:authorities="org.medianexus.standin.art"
            android:exported="true" />

        <!-- Lets the rig make the stand-in misbehave on purpose (see Faults.kt). -->
        <receiver
            android:name=".Faults"
            android:exported="true" />
    </application>
</manifest>
